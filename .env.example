# Copy to .env for local testing (.env is gitignored). GitHub Actions uses repo secrets.

# OpenRouter (required)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ---- Posting via BOT (preferred; bot takes precedence over webhook) ----
# Discord: bot token + text-channel id. Bot must be in the server with
#   "View Channel" + "Send Messages" permission on that channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Slack: Bot User OAuth Token (xoxb-...) with chat:write, invited to the channel.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ---- Posting via incoming WEBHOOK (fallback; used only if bot token absent) ----
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
